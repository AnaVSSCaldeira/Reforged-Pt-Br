msgstr "如果目标距离太远, 猪战士就会向他们冲撞。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO.NAME"
msgid "Rhinocebro Snapback"
msgstr "后扣帽犀牛兄弟"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO.DESC"
msgid "Would probably steal your lunch money."
msgstr "可能会偷走你的午饭钱。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.CHEER.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.CHEER.NAME"
msgid "Bro Cheer"
msgstr "兄弟欢呼"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.CHEER.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.CHEER.DESC"
msgid "Cheers his bro, Flatbrim, to gain a permanent +25 damage boost."
msgstr "为他的平檐帽兄弟欢呼, 获得永久的+25伤害加成。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.RAM.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.RAM.NAME"
msgid "Ram"
msgstr "撞击"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.RAM.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.RAM.DESC"
msgid "Charges forward with his horn doing damage in a large radius."
msgstr "用他的角向前冲锋, 造成大范围的伤害。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.NAME"
msgid "Rhinocebro Flatbrim"
msgstr "平檐帽犀牛兄弟"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.DESC"
msgid "Would probably stuff you in a locker."
msgstr "可能会将你塞进储物柜。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.CHEER.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.CHEER.NAME"
msgid "Bro Cheer"
msgstr "兄弟欢呼"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.CHEER.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.CHEER.DESC"
msgid "Cheers his bro, Snapback, to gain a permanent +25 damage boost."
msgstr "为他的后扣帽兄弟欢呼, 获得永久的+25伤害加成。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.RAM.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.RAM.NAME"
msgid "Ram"
msgstr "撞击"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.RAM.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.RAM.DESC"
msgid "Charges forward with his horn doing damage in a large radius."
msgstr "用他的角向前冲锋, 造成大范围的伤害。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBROS.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBROS.NAME"
msgid "Rhinocebros"
msgstr "犀牛兄弟"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBROS.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBROS.DESC"
msgid "Spawn the two as a pair, linked and everything."
msgstr "生成两个成对, 联结在一起和所有一切。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.CHEER.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.CHEER.NAME"
msgid "Bro Cheer"
msgstr "兄弟欢呼"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.CHEER.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.CHEER.DESC"
msgid "Cheer each other to gain a permanent +25 damage boost."
msgstr "互相欢呼, 获得永久的+25伤害加成。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.RAM.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.RAM.NAME"
msgid "Ram"
msgstr "撞击"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.RAM.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.RAM.DESC"
msgid "Charges forward with his horn doing damage in a large radius."
msgstr "用他的角向前冲锋, 造成大范围的伤害。"

#. STRINGS.REFORGED.ENEMIES.SWINECLOPS.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.SWINECLOPS.NAME"
msgid "Infernal Swineclops"
msgstr "地狱独眼巨猪"

#. STRINGS.REFORGED.ENEMIES.SWINECLOPS.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.SWINECLOPS.DESC"
msgid "Pugna's last resort, a ferocious beast imprisoned for how deadly he is."
msgstr "普格纳的最后一招是一只凶猛的野兽, 因他的致命性而入狱。"

#. STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.DEFENSIVE_STANCE.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.DEFENSIVE_STANCE.NAME"
msgid "Defensive Stance"
msgstr "防守姿态"

#. STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.DEFENSIVE_STANCE.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.DEFENSIVE_STANCE.DESC"
msgid "Moves faster, takes 50% less damage, but can only do one attack."
msgstr "移速更快, 受到的伤害降低50%, 但只能进行一次攻击。"

#. STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.OFFENSIVE_STANCE.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.OFFENSIVE_STANCE.NAME"
msgid "Offensive Stance"
msgstr "进攻姿态"

#. STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.OFFENSIVE_STANCE.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.OFFENSIVE_STANCE.DESC"
msgid "Can combo punches, can buff itself, can use bellyflop, but moves slower."
msgstr "可以连击, 可以增幅自己, 可以用肚皮攻击, 但移速较慢。"

# ---------
# -- PET --
# ---------

#. STRINGS.REFORGED.PETS.GOLEM.NAME
msgctxt "STRINGS.REFORGED.PETS.GOLEM.NAME"
msgid "Golem"
msgstr "傀儡"

#. STRINGS.REFORGED.PETS.GOLEM.DESC
msgctxt "STRINGS.REFORGED.PETS.GOLEM.DESC"
msgid "Continously throws fireballs at nearby mobs. Can't move though."
msgstr "不断向附近的怪物扔火球, 虽然它不能移动。"

#. STRINGS.REFORGED.PETS.BABYSPIDER.NAME
msgctxt "STRINGS.REFORGED.PETS.BABYSPIDER.NAME"
msgid "Baby Spiders"
msgstr "蜘蛛宝宝"

#. STRINGS.REFORGED.PETS.BABYSPIDER.DESC
msgctxt "STRINGS.REFORGED.PETS.BABYSPIDER.DESC"
msgid "These cute lil fellas will help you take down foes. They can't be targeted or killed."
msgstr "这些可爱的小家伙们会帮你击倒敌人。他们无法成为目标或被杀死。"

#. STRINGS.REFORGED.PETS.MERM_GUARD.NAME
msgctxt "STRINGS.REFORGED.PETS.MERM_GUARD.NAME"
msgid "Merm Guard"
msgstr "鱼人守卫"

#. STRINGS.REFORGED.PETS.MERM_GUARD.DESC
msgctxt "STRINGS.REFORGED.PETS.MERM_GUARD.DESC"
msgid "From the swamp comes the menacing merm guards. They will die from overheating after awhile."
msgstr "险恶的鱼人守卫从沼泽中来。他们过一会就会因过热而死。"

#. STRINGS.REFORGED.PETS.MEAN_FLYTRAP.NAME
msgctxt "STRINGS.REFORGED.PETS.MEAN_FLYTRAP.NAME"
msgid "Seedling"
msgstr "幼苗"

#. STRINGS.REFORGED.PETS.MEAN_FLYTRAP.DESC
msgctxt "STRINGS.REFORGED.PETS.MEAN_FLYTRAP.DESC"
msgid "Wormwood's friends have come to lend a tooth or two. They will die from the heat after awhile."
msgstr "沃姆伍德的朋友过来借一两颗牙。他们过一会就会因过热而死。"

#. STRINGS.REFORGED.PETS.ADULT_FLYTRAP.NAME
msgctxt "STRINGS.REFORGED.PETS.ADULT_FLYTRAP.NAME"
msgid "Snaptooth"
msgstr "咬牙"

#. STRINGS.REFORGED.PETS.ADULT_FLYTRAP.DESC
msgctxt "STRINGS.REFORGED.PETS.ADULT_FLYTRAP.DESC"
msgid "This fiend will take large bites out of the competition. They will die from the heat after awhile."
msgstr "这个恶魔会在竞争中占上风。他们过一会就会因过热而死。"

#. STRINGS.REFORGED.PETS.FORGE_ABIGAIL.NAME
msgctxt "STRINGS.REFORGED.PETS.FORGE_ABIGAIL.NAME"
msgid "Abigail"
msgstr "阿比盖尔"

#. STRINGS.REFORGED.PETS.FORGE_ABIGAIL.DESC
msgctxt "STRINGS.REFORGED.PETS.FORGE_ABIGAIL.DESC"
msgid "Wendy's sister has come to throw the game. Respawns quite awhile after death."
msgstr "温蒂的姐姐过来故意输掉比赛。死亡后用相当长的时间重生。"

#. STRINGS.REFORGED.PETS.FORGE_BERNIE.NAME
msgctxt "STRINGS.REFORGED.PETS.FORGE_BERNIE.NAME"
msgid "Bernie"
msgstr "伯尼"

#. STRINGS.REFORGED.PETS.FORGE_BERNIE.DESC
msgctxt "STRINGS.REFORGED.PETS.FORGE_BERNIE.DESC"
msgid "He will draw aggro away from you when you're in danger. Can be revived when fallen."
msgstr "在你处于危险之中时, 他会从你身边吸引仇恨。跌倒时可以复活。"

# -----------
# -- HELMS --
# -----------

#. STRINGS.REFORGED.HELMS.FEATHEREDWREATH.NAME
msgctxt "STRINGS.REFORGED.HELMS.FEATHEREDWREATH.NAME"
msgid "Feathered Wreath"
msgstr "羽毛头环"

#. STRINGS.REFORGED.HELMS.FEATHEREDWREATH.DESC
msgctxt "STRINGS.REFORGED.HELMS.FEATHEREDWREATH.DESC"
msgid "Have feet as light as a feather and have the hat to match!"
msgstr "脚像羽毛一样轻, 并且有匹配的帽子！"

#. STRINGS.REFORGED.HELMS.FLOWERHEADBAND.NAME
msgctxt "STRINGS.REFORGED.HELMS.FLOWERHEADBAND.NAME"
msgid "Flower Headband"
msgstr "花饰头带"

#. STRINGS.REFORGED.HELMS.FLOWERHEADBAND.DESC
msgctxt "STRINGS.REFORGED.HELMS.FLOWERHEADBAND.DESC"
msgid "Wear a healing flower on your head! When healed, gain 25% more health."
msgstr "戴在头上的愈合花！被治愈时, 获得额外25%的生命值。"

#. STRINGS.REFORGED.HELMS.BARBEDHELM.NAME
msgctxt "STRINGS.REFORGED.HELMS.BARBEDHELM.NAME"
msgid "Barbed Helm"
msgstr "带刺头盔"

#. STRINGS.REFORGED.HELMS.BARBEDHELM.DESC
msgctxt "STRINGS.REFORGED.HELMS.BARBEDHELM.DESC"
msgid "Feel the wrath of Barb! Physical attacks deal 10% more damage."
msgstr "感受带刺的愤怒！物理攻击额外提高10%。"

#. STRINGS.REFORGED.HELMS.NOXHELM.NAME
msgctxt "STRINGS.REFORGED.HELMS.NOXHELM.NAME"
msgid "Nox Helm"
msgstr "诺克斯牛头盔"

#. STRINGS.REFORGED.HELMS.NOXHELM.DESC
msgctxt "STRINGS.REFORGED.HELMS.NOXHELM.DESC"
msgid "More horns always means more damage. Specifically, 15% damage."
msgstr "更多的角总是意味着更多的伤害。具体来说, 15%伤害。"

#. STRINGS.REFORGED.HELMS.WOVENGARLAND.NAME
msgctxt "STRINGS.REFORGED.HELMS.WOVENGARLAND.NAME"
msgid "Woven Garland"
msgstr "编织花环"

#. STRINGS.REFORGED.HELMS.WOVENGARLAND.DESC
msgctxt "STRINGS.REFORGED.HELMS.WOVENGARLAND.DESC"
msgid "Imbued with the power of a mythical dryad, this increases healing dealt by 20%."
msgstr "充满神话般树妖的力量, 可以使治疗量提高20%。"

#. STRINGS.REFORGED.HELMS.CLAIRVOYANTCROWN.NAME
msgctxt "STRINGS.REFORGED.HELMS.CLAIRVOYANTCROWN.NAME"
msgid "Clairvoyant Crown"
msgstr "洞察皇冠"

#. STRINGS.REFORGED.HELMS.CLAIRVOYANTCROWN.DESC
msgctxt "STRINGS.REFORGED.HELMS.CLAIRVOYANTCROWN.DESC"
msgid "Become a minister of magic! Deal more magic damage, have faster cooldowns and movement speed."
msgstr "成为魔法部长！造成更多魔法伤害, 并具有更快的冷却时间和移速。"

#. STRINGS.REFORGED.HELMS.CRYSTALTIARA.NAME
msgctxt "STRINGS.REFORGED.HELMS.CRYSTALTIARA.NAME"
msgid "Crystal Tiara"
msgstr "水晶头饰"

#. STRINGS.REFORGED.HELMS.CRYSTALTIARA.DESC
msgctxt "STRINGS.REFORGED.HELMS.CRYSTALTIARA.DESC"
msgid "Apparently healing crystals aren't a sham! Gain 10% faster cooldowns."
msgstr "显然治愈水晶不是假的！冷却时间提高10%。"

#. STRINGS.REFORGED.HELMS.BLOSSOMEDWREATH.NAME
msgctxt "STRINGS.REFORGED.HELMS.BLOSSOMEDWREATH.NAME"
msgid "Blossomed Wreath"
msgstr "绽放花环"

#. STRINGS.REFORGED.HELMS.BLOSSOMEDWREATH.DESC
msgctxt "STRINGS.REFORGED.HELMS.BLOSSOMEDWREATH.DESC"
msgid "Put a miniature healing circle right on your head! Heals 2 HP/sec."
msgstr "在你的头上放一个微型治愈圈！每秒恢复2生命值。"

#. STRINGS.REFORGED.HELMS.RESPLENDENTNOXHELM.NAME
msgctxt "STRINGS.REFORGED.HELMS.RESPLENDENTNOXHELM.NAME"
msgid "Resplendent Nox Helm"
msgstr "华丽的诺克斯牛头盔"

#. STRINGS.REFORGED.HELMS.RESPLENDENTNOXHELM.DESC
msgctxt "STRINGS.REFORGED.HELMS.RESPLENDENTNOXHELM.DESC"
msgid "This excessive amount of horns grants high physical damage, faster cooldowns and movement speed."
msgstr "过多的角造成很高的物理伤害, 且具有更快的冷却时间和移速。"

#. STRINGS.REFORGED.HELMS.LAVAARENA_CHEFHAT.NAME
msgctxt "STRINGS.REFORGED.HELMS.LAVAARENA_CHEFHAT.NAME"
msgid "Chef Hat"
msgstr "厨师帽"

#. STRINGS.REFORGED.HELMS.LAVAARENA_CHEFHAT.DESC
msgctxt "STRINGS.REFORGED.HELMS.LAVAARENA_CHEFHAT.DESC"
msgid "Wearing this, everyone will believe that you're a master chef, so you no longer need to watch your own food cook."
msgstr "戴上它后所有人都会相信你是大厨, 因此你不再需要看锅。"

# ----------
# -- BODY --
# ----------

#. STRINGS.REFORGED.ARMOR.REEDTUNIC.NAME
msgctxt "STRINGS.REFORGED.ARMOR.REEDTUNIC.NAME"
msgid "Reed Tunic"
msgstr "芦苇束腰外衣"

#. STRINGS.REFORGED.ARMOR.REEDTUNIC.DESC
msgctxt "STRINGS.REFORGED.ARMOR.REEDTUNIC.DESC"
msgid "Reeds aren't the best form of defense."
msgstr "芦苇不是最好的防御方式。"

#. STRINGS.REFORGED.ARMOR.FEATHEREDTUNIC.NAME
msgctxt "STRINGS.REFORGED.ARMOR.FEATHEREDTUNIC.NAME"
msgid "Feathered Reed Tunic"
msgstr "带羽毛的芦苇外衣"

#. STRINGS.REFORGED.ARMOR.FEATHEREDTUNIC.DESC
msgctxt "STRINGS.REFORGED.ARMOR.FEATHEREDTUNIC.DESC"
msgid "A feather got stuck in your tunic. It makes you run slightly faster."
msgstr "在你的外衣上卡着一根羽毛。它使你跑得稍快一点。"

#. STRINGS.REFORGED.ARMOR.FORGE_WOODARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.FORGE_WOODARMOR.NAME"
msgid "Wood Armor"
msgstr "木质护甲"

#. STRINGS.REFORGED.ARMOR.FORGE_WOODARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.FORGE_WOODARMOR.DESC"
msgid "Simple yet effective defense."
msgstr "简单而有效的防御。"

#. STRINGS.REFORGED.ARMOR.JAGGEDARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.JAGGEDARMOR.NAME"
msgid "Jagged Wood Armor"
msgstr "锯齿木甲"

#. STRINGS.REFORGED.ARMOR.JAGGEDARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.JAGGEDARMOR.DESC"
msgid "Decked out in monster teeth, this armor protects AND attacks."
msgstr "镶有怪兽牙齿的装饰, 这个护甲可以保护和攻击。"

#. STRINGS.REFORGED.ARMOR.SILKENARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.SILKENARMOR.NAME"
msgid "Silken Wood Armor"
msgstr "软木护甲"

#. STRINGS.REFORGED.ARMOR.SILKENARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.SILKENARMOR.DESC"
msgid "This very simple sash wrapped around wood grants faster cooldowns."
msgstr "这个很简单地包裹在木头上的饰带可以加快冷却时间。"

#. STRINGS.REFORGED.ARMOR.SPLINTMAIL.NAME
msgctxt "STRINGS.REFORGED.ARMOR.SPLINTMAIL.NAME"
msgid "Stone Splint Mail"
msgstr "石头板甲"

#. STRINGS.REFORGED.ARMOR.SPLINTMAIL.DESC
msgctxt "STRINGS.REFORGED.ARMOR.SPLINTMAIL.DESC"
msgid "Light stone armor that grants higher defense than wood."
msgstr "轻质石盔甲的防御力高于木质。"

#. STRINGS.REFORGED.ARMOR.STEADFASTARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.STEADFASTARMOR.NAME"
msgid "Steadfast Stone Armor"
msgstr "坚固的石质护甲"

#. STRINGS.REFORGED.ARMOR.STEADFASTARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.STEADFASTARMOR.DESC"
msgid "Too many rocks! This heavy armor slows you down, but makes you harder to push around."
msgstr "石头太多了！这种沉重的盔甲会使你减速, 但会使你更难被推开。"

#. STRINGS.REFORGED.ARMOR.STEADFASTGRANDARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.STEADFASTGRANDARMOR.NAME"
msgid "Steadfast Grand Armor"
msgstr "华丽的稳固盔甲"

#. STRINGS.REFORGED.ARMOR.STEADFASTGRANDARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.STEADFASTGRANDARMOR.DESC"
msgid "Become the ultimate tank!"
msgstr "成为终极坦克！"

#. STRINGS.REFORGED.ARMOR.WHISPERINGGRANDARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.WHISPERINGGRANDARMOR.NAME"
msgid "Whispering Grand Armor"
msgstr "华丽的低语盔甲"

#. STRINGS.REFORGED.ARMOR.WHISPERINGGRANDARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.WHISPERINGGRANDARMOR.DESC"
msgid "Boost your companions with ancient power!"
msgstr "用古老的力量助你一臂之力！"

#. STRINGS.REFORGED.ARMOR.SILKENGRANDARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.SILKENGRANDARMOR.NAME"
msgid "Silken Grand Armor"
msgstr "华丽的丝滑盔甲"

#. STRINGS.REFORGED.ARMOR.SILKENGRANDARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.SILKENGRANDARMOR.DESC"
msgid "The supreme stamina booster!"
msgstr "优质的耐力助推器！"

#. STRINGS.REFORGED.ARMOR.JAGGEDGRANDARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.JAGGEDGRANDARMOR.NAME"
msgid "Jagged Grand Armor"
msgstr "华丽的尖突盔甲"

#. STRINGS.REFORGED.ARMOR.JAGGEDGRANDARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.JAGGEDGRANDARMOR.DESC"
msgid "Rip and tear through your foes with this armor!"
msgstr "用这个盔甲撕裂敌人！"

# -------------
# -- WEAPONS --
# -------------

#. STRINGS.REFORGED.WEAPONS.FORGEDARTS.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FORGEDARTS.NAME"
msgid "Darts"
msgstr "吹箭"

#. STRINGS.REFORGED.WEAPONS.FORGEDARTS.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FORGEDARTS.DESC"
msgid "A simple yet powerful blowdart."
msgstr "一个简单而强大的吹箭。"

#. STRINGS.REFORGED.WEAPONS.FORGEDARTS.ABILITIES.BARRAGE.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FORGEDARTS.ABILITIES.BARRAGE.NAME"
msgid "Barrage"
msgstr "齐射"

#. STRINGS.REFORGED.WEAPONS.FORGEDARTS.ABILITIES.BARRAGE.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FORGEDARTS.ABILITIES.BARRAGE.DESC"
msgid "Shoot a flurry of darts in one direction."
msgstr "朝一个方向射击一连串吹箭。"

#. STRINGS.REFORGED.WEAPONS.MOLTENDARTS.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.MOLTENDARTS.NAME"
msgid "Molten Darts"
msgstr "熔化吹箭"

#. STRINGS.REFORGED.WEAPONS.MOLTENDARTS.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.MOLTENDARTS.DESC"
msgid "Don't burn your tongue!"
msgstr "不要烧坏你的舌头！"

#. STRINGS.REFORGED.WEAPONS.MOLTENDARTS.ABILITIES.FIRE_BLAST.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.MOLTENDARTS.ABILITIES.FIRE_BLAST.NAME"
msgid "Fire Blast"
msgstr "爆破"

#. STRINGS.REFORGED.WEAPONS.MOLTENDARTS.ABILITIES.FIRE_BLAST.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.MOLTENDARTS.ABILITIES.FIRE_BLAST.DESC"
msgid "Shoot a single fiery blast of magma at your foes!"
msgstr "向敌人射击一股火热的岩浆！"

#. STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.NAME"
msgid "Infernal Staff"
msgstr "地狱魔杖"

#. STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.DESC"
msgid "Harness the power of fire!"
msgstr "利用火的力量！"

#. STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.ABILITIES.METEOR.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.ABILITIES.METEOR.NAME"
msgid "Meteor"
msgstr "流星"

#. STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.ABILITIES.METEOR.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.ABILITIES.METEOR.DESC"
msgid "Call down a giant meteor from the heavens!"
msgstr "从天堂里召唤一顆巨大的流星！"

#. STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.NAME"
msgid "Forge Hammer"
msgstr "熔炉锤"

#. STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.DESC"
msgid "Bash some skulls in with this heavy hammer."
msgstr "用沉重的锤子杂碎一些头骨。"

#. STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.ABILITIES.SLAM.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.ABILITIES.SLAM.NAME"
msgid "Slam"
msgstr "撞击"

#. STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.ABILITIES.SLAM.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.ABILITIES.SLAM.DESC"
msgid "Shake the ground at your feet, hitting everything at once."
msgstr "在你的脚下摇动地面, 一次击中一切。"

#. STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.NAME"
msgid "Living Staff"
msgstr "生存魔杖"

#. STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.DESC"
msgid "A very useful tool to keep you and your allies alive."
msgstr "一个非常有用的工具, 可以使你和你的盟友存活。"

#. STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.ABILITIES.HEALING_CIRCLE.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.ABILITIES.HEALING_CIRCLE.NAME"
msgid "Healing Circle"
msgstr "治疗圈"

#. STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.ABILITIES.HEALING_CIRCLE.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.ABILITIES.HEALING_CIRCLE.DESC"
msgid "Spawn a magical circle of blossoming healing flowers."
msgstr "生成一个神奇的治愈花圈。"

#. STRINGS.REFORGED.WEAPONS.PITHPIKE.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.PITHPIKE.NAME"
msgid "Spear"
msgstr "长矛"

#. STRINGS.REFORGED.WEAPONS.PITHPIKE.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.PITHPIKE.DESC"
msgid "Wigfrid's go-to weapon for battle."
msgstr "薇格弗德的战斗必备武器。"

#. STRINGS.REFORGED.WEAPONS.PITHPIKE.ABILITIES.CHARGE.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.PITHPIKE.ABILITIES.CHARGE.NAME"
msgid "Charge"
msgstr "冲撞"

#. STRINGS.REFORGED.WEAPONS.PITHPIKE.ABILITIES.CHARGE.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.PITHPIKE.ABILITIES.CHARGE.DESC"
msgid "Dash through your foes, and flip some Snortoises while you're at it."
msgstr "冲刺穿过敌人, 并在冲刺时翻转一些坦克龟。"

#. STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.NAME"
msgid "Spiral Spear"
msgstr "螺旋矛"

#. STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.DESC"
msgid "Keep the pointy end away from you!"
msgstr "保持远离尖锐末端！"

#. STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.ABILITIES.SLAM.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.ABILITIES.SLAM.NAME"
msgid "Slam"
msgstr "猛击"

#. STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.ABILITIES.SLAM.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.ABILITIES.SLAM.DESC"
msgid "Jump high into the sky and SLAM down on the enemy!"
msgstr "跳入高空, 朝敌人向下猛击！"

#. STRINGS.REFORGED.WEAPONS.RILEDLUCY.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.RILEDLUCY.NAME"
msgid "Riled Lucy"
msgstr "暴怒的露西"

#. STRINGS.REFORGED.WEAPONS.RILEDLUCY.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.RILEDLUCY.DESC"
msgid "This Lucy is a lot more quiet and ready to fight."
msgstr "这个露西安静的多, 随时准备战斗。"

#. STRINGS.REFORGED.WEAPONS.RILEDLUCY.ABILITIES.THROW.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.RILEDLUCY.ABILITIES.THROW.NAME"
msgid "Throw"
msgstr "扔"

#. STRINGS.REFORGED.WEAPONS.RILEDLUCY.ABILITIES.THROW.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.RILEDLUCY.ABILITIES.THROW.DESC"
msgid "Throw Woodie's beloved axe headfirst into an enemy."
msgstr "率先将吴迪心爱的斧头扔向敌人。"

#. STRINGS.REFORGED.WEAPONS.BACONTOME.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.BACONTOME.NAME"
msgid "Tome of Beckoning"
msgstr "召唤之书"

#. STRINGS.REFORGED.WEAPONS.BACONTOME.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.BACONTOME.DESC"
msgid "Summon an ancient ally."
msgstr "召唤一个远古盟友。"

#. STRINGS.REFORGED.WEAPONS.BACONTOME.ABILITIES.SUMMON_GOLEM.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.BACONTOME.ABILITIES.SUMMON_GOLEM.NAME"
msgid "Summon Golem"
msgstr "召唤傀儡"

#. STRINGS.REFORGED.WEAPONS.BACONTOME.ABILITIES.SUMMON_GOLEM.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.BACONTOME.ABILITIES.SUMMON_GOLEM.DESC"
msgid "Spawns a rock golem from the depths of the Forge."
msgstr "从熔炉地底深处生成一个石头傀儡。"

#. STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.NAME"
msgid "Petrifying Tome"
msgstr "石化之书"

#. STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.DESC"
msgid "Makes your enemies scared stiff."
msgstr "使你的敌人吓呆。"

#. STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.ABILITIES.PETRIFY.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.ABILITIES.PETRIFY.NAME"
msgid "Petrify"
msgstr "石化"

#. STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.ABILITIES.PETRIFY.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.ABILITIES.PETRIFY.DESC"
msgid "Encase your foes in a tomb of rocks. Not all of them will stay though."
msgstr "将敌人包裹在一块岩石墓中。尽管并非所有人都会留下来。"

#. STRINGS.REFORGED.WEAPONS.FIREBOMB.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FIREBOMB.NAME"
msgid "Hearthsfire Crystals"
msgstr "炉火晶石"

#. STRINGS.REFORGED.WEAPONS.FIREBOMB.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FIREBOMB.DESC"
msgid "Don't shake it!"
msgstr "不要摇动它！"

#. STRINGS.REFORGED.WEAPONS.FIREBOMB.ABILITIES.THROW.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FIREBOMB.ABILITIES.THROW.NAME"
msgid "Explosive Throw"
msgstr "爆炸投掷"

#. STRINGS.REFORGED.WEAPONS.FIREBOMB.ABILITIES.THROW.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FIREBOMB.ABILITIES.THROW.DESC"
msgid "Throw these at the enemy and watch them explode!"
msgstr "将它们扔向敌人, 看着他们爆炸！"

#. STRINGS.REFORGED.WEAPONS.BLACKSMITHSEDGE.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.BLACKSMITHSEDGE.NAME"
msgid "Blacksmith's Edge"
msgstr "铁匠之刃"

#. STRINGS.REFORGED.WEAPONS.BLACKSMITHSEDGE.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.BLACKSMITHSEDGE.DESC"
msgid "You can lift that?!"
msgstr "你能举起它？！"

#. STRINGS.REFORGED.WEAPONS.BLACKSMITHSEDGE.ABILITIES.PARRY.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.BLACKSMITHSEDGE.ABILITIES.PARRY.NAME"
msgid "Parry"
msgstr "格挡"

#. STRINGS.REFORGED.WEAPONS.BLACKSMITHSEDGE.ABILITIES.PARRY.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.BLACKSMITHSEDGE.ABILITIES.PARRY.DESC"
msgid "Nothing can get through this blade's heavy hilt!"
msgstr "没有任何东西可以穿透这把重剑！"

#. STRINGS.REFORGED.WEAPONS.SEEDLINGTOME.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.SEEDLINGTOME.NAME"
msgid "Seedling Tome"
msgstr "幼苗之书"

#. STRINGS.REFORGED.WEAPONS.SEEDLINGTOME.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.SEEDLINGTOME.DESC"
msgid ""
msgstr ""

#. STRINGS.REFORGED.WEAPONS.SEEDLINGTOME.ABILITIES.SUMMON_SEEDLING.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.SEEDLINGTOME.ABILITIES.SUMMON_SEEDLING.NAME"
msgid "Summon Seedling"
msgstr "召唤幼苗"

#. STRINGS.REFORGED.WEAPONS.SEEDLINGTOME.ABILITIES.SUMMON_SEEDLING.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.SEEDLINGTOME.ABILITIES.SUMMON_SEEDLING.DESC"
msgid ""
msgstr ""

#. STRINGS.REFORGED.WEAPONS.FLYTRAPTOME.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FLYTRAPTOME.NAME"
msgid "Flytrap Tome"
msgstr "捕蝇草之书"

#. STRINGS.REFORGED.WEAPONS.FLYTRAPTOME.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FLYTRAPTOME.DESC"
msgid ""
msgstr ""

#. STRINGS.REFORGED.WEAPONS.FLYTRAPTOME.ABILITIES.SUMMON_FLYTRAP.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FLYTRAPTOME.ABILITIES.SUMMON_FLYTRAP.NAME"
msgid "Summon Flytrap"
msgstr "召唤捕蝇草"

#. STRINGS.REFORGED.WEAPONS.FLYTRAPTOME.ABILITIES.SUMMON_FLYTRAP.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FLYTRAPTOME.ABILITIES.SUMMON_FLYTRAP.DESC"
msgid ""
msgstr ""

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.NAME"
msgid "Seedling Darts"
msgstr "幼苗吹箭"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.DESC"
msgid "Wormwood put his heart into this. And his other limbs."
msgstr "沃姆伍德对此全心全意。还有他的其它肢体。"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.ABILITIES.PLANT_SEEDLING.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.ABILITIES.PLANT_SEEDLING.NAME"
msgid "Plant Seedling"
msgstr "植物幼苗"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.ABILITIES.PLANT_SEEDLING.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.ABILITIES.PLANT_SEEDLING.DESC"
msgid "Hastily grow an organic ally."
msgstr "仓促地长成有机盟友。"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDART2.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDART2.NAME"
msgid "Scattertooth"
msgstr "散射之齿"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDART2.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDART2.DESC"
msgid "Shoot 3 darts at once!"
msgstr "一次性射出三支吹箭！"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDART2.ABILITIES.PLANT_SNAPTOOTH.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDART2.ABILITIES.PLANT_SNAPTOOTH.NAME"
msgid "Plant Snaptooth"
msgstr "植物咬牙"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDART2.ABILITIES.PLANT_SNAPTOOTH.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDART2.ABILITIES.PLANT_SNAPTOOTH.DESC"
msgid "Grow a rooted Snaptooth to chew up your enemies."
msgstr "生长一棵扎根的咬牙来咀嚼你的敌人。"

#. STRINGS.REFORGED.WEAPONS.TELEPORT_STAFF.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.TELEPORT_STAFF.NAME"
msgid "Teleport Staff"
msgstr "传送魔杖"

#. STRINGS.REFORGED.WEAPONS.TELEPORT_STAFF.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.TELEPORT_STAFF.DESC"
msgid "Escape certain doom! For a price..."
msgstr "逃离某些厄运！要付出代价..."

#. STRINGS.REFORGED.WEAPONS.TELEPORT_STAFF.ABILITIES.TELEPORT.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.TELEPORT_STAFF.ABILITIES.TELEPORT.NAME"
msgid "Teleport"
msgstr "传送"

#. STRINGS.REFORGED.WEAPONS.TELEPORT_STAFF.ABILITIES.TELEPORT.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.TELEPORT_STAFF.ABILITIES.TELEPORT.DESC"
msgid "Travel wherever your puny heart desires."
msgstr "去任何你弱小的心灵想去的地方。"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SPATULA.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SPATULA.NAME"
msgid "Spatula"
msgstr "锅铲"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SPATULA.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SPATULA.DESC"
msgid "Not great as a weapon, but it'll do with a pinch of salt."
msgstr "虽然不适合作武器, 但它能撒一点盐。"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SPATULA.ABILITIES.COOK.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SPATULA.ABILITIES.COOK.NAME"
msgid "Cook"
msgstr "烹饪"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SPATULA.ABILITIES.COOK.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SPATULA.ABILITIES.COOK.DESC"
msgid "Cook food for all nearby players and feed them when ready."
msgstr "为附近的所有玩家烹饪食物, 并在准备好时喂给他们。"

#. STRINGS.REFORGED.WEAPONS.FORGE_TRIDENT.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FORGE_TRIDENT.NAME"
msgid "Trident"
msgstr "三叉戟"

#. STRINGS.REFORGED.WEAPONS.FORGE_TRIDENT.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FORGE_TRIDENT.DESC"
msgid "Don't let the rickety look fool you, this trident packs a punch!"
msgstr "不要让它摇摇晃晃的样子骗了你, 这个三叉戟威力很大！"

#. STRINGS.REFORGED.WEAPONS.FORGE_TRIDENT.ABILITIES.CALL_GUARDS.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FORGE_TRIDENT.ABILITIES.CALL_GUARDS.NAME"
msgid "Summon Merm Guard"
msgstr "召唤鱼人守卫"

#. STRINGS.REFORGED.WEAPONS.FORGE_TRIDENT.ABILITIES.CALL_GUARDS.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FORGE_TRIDENT.ABILITIES.CALL_GUARDS.DESC"
msgid "Spawn a loyal Merm Guard to fight alongside you."
msgstr "生成一个忠诚的鱼人守卫与你并肩作战。"

#. STRINGS.REFORGED.WEAPONS.GAUNTLET.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.GAUNTLET.NAME"
msgid "Gauntlets"
msgstr "拳套"

#. STRINGS.REFORGED.WEAPONS.GAUNTLET.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.GAUNTLET.DESC"
msgid "Punch through foes with these Hands of Doom."
msgstr "用这些末日之手冲破敌人。"

#. STRINGS.REFORGED.WEAPONS.GAUNTLET.ABILITIES.BARRAGE.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.GAUNTLET.ABILITIES.BARRAGE.NAME"
msgid "Charged Punch"
msgstr "充能重拳"

#. STRINGS.REFORGED.WEAPONS.GAUNTLET.ABILITIES.BARRAGE.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.GAUNTLET.ABILITIES.BARRAGE.DESC"
msgid "Lean into your punch to knockback anything in your path."
msgstr "用你的拳头向前冲, 击退道路上的一切。"

