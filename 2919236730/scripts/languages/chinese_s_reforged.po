#. STRINGS.REFORGED.BUFFS.BATTLESTANDARD_DAMAGER.NAME
msgctxt "STRINGS.REFORGED.BUFFS.BATTLESTANDARD_DAMAGER.NAME"
msgid "Damage Banner"
msgstr "破坏旗帜"

#. STRINGS.REFORGED.BUFFS.BATTLESTANDARD_DAMAGER.DESC
msgctxt "STRINGS.REFORGED.BUFFS.BATTLESTANDARD_DAMAGER.DESC"
msgid "Increases the damage of all mobs by x%."
msgstr "增加所有怪物x%的伤害。"

#. STRINGS.REFORGED.BUFFS.BATTLESTANDARD_SHIELD.NAME
msgctxt "STRINGS.REFORGED.BUFFS.BATTLESTANDARD_SHIELD.NAME"
msgid "Shield Banner"
msgstr "掩护旗帜"

#. STRINGS.REFORGED.BUFFS.BATTLESTANDARD_SHIELD.DESC
msgctxt "STRINGS.REFORGED.BUFFS.BATTLESTANDARD_SHIELD.DESC"
msgid "Decreases all damage done to mobs by x%."
msgstr "减少对所有怪物造成x%的伤害。"

#. STRINGS.REFORGED.BUFFS.BATTLESTANDARD_HEAL.NAME
msgctxt "STRINGS.REFORGED.BUFFS.BATTLESTANDARD_HEAL.NAME"
msgid "Heal Banner"
msgstr "治疗旗帜"

#. STRINGS.REFORGED.BUFFS.BATTLESTANDARD_HEAL.DESC
msgctxt "STRINGS.REFORGED.BUFFS.BATTLESTANDARD_HEAL.DESC"
msgid "Gives all mobs a regen of x%."
msgstr "恢复所有怪物x%的血量"

#. STRINGS.REFORGED.BUFFS.BATTLESTANDARD_SPEED.NAME
msgctxt "STRINGS.REFORGED.BUFFS.BATTLESTANDARD_SPEED.NAME"
msgid "Speed Banner"
msgstr "速度旗帜"

#. STRINGS.REFORGED.BUFFS.BATTLESTANDARD_SPEED.DESC
msgctxt "STRINGS.REFORGED.BUFFS.BATTLESTANDARD_SPEED.DESC"
msgid "Increases the speed of all mobs by x%."
msgstr "增加所有怪物x%的速度"

#. STRINGS.REFORGED.BUFFS.ACTIVATE_BATTLECRY.NAME
msgctxt "STRINGS.REFORGED.BUFFS.ACTIVATE_BATTLECRY.NAME"
msgid "Activate Battlecry"
msgstr "启用战斗口号"

#. STRINGS.REFORGED.BUFFS.ACTIVATE_BATTLECRY.DESC
msgctxt "STRINGS.REFORGED.BUFFS.ACTIVATE_BATTLECRY.DESC"
msgid "If you yell loudly enough everyone around you can hit harder."
msgstr "如果你喊得足够大声, 周围所有人都能打得更重。"

#. STRINGS.REFORGED.BUFFS.GIVE_BATTLECRY.NAME
msgctxt "STRINGS.REFORGED.BUFFS.GIVE_BATTLECRY.NAME"
msgid "Give Battlecry"
msgstr "给予战斗口号"

#. STRINGS.REFORGED.BUFFS.GIVE_BATTLECRY.DESC
msgctxt "STRINGS.REFORGED.BUFFS.GIVE_BATTLECRY.DESC"
msgid "If you yell at yourself you can hit harder."
msgstr "如果你对自己大喊大叫, 你会打得更重。"

#. STRINGS.REFORGED.BUFFS.ACTIVATE_AMPLIFY.NAME
msgctxt "STRINGS.REFORGED.BUFFS.ACTIVATE_AMPLIFY.NAME"
msgid "Activate Amplify"
msgstr "激活增幅"

#. STRINGS.REFORGED.BUFFS.ACTIVATE_AMPLIFY.DESC
msgctxt "STRINGS.REFORGED.BUFFS.ACTIVATE_AMPLIFY.DESC"
msgid "Make yourself sparkly!"
msgstr "让你自己更闪耀！"

#. STRINGS.REFORGED.BUFFS.ACTIVATE_MIGHTY.NAME
msgctxt "STRINGS.REFORGED.BUFFS.ACTIVATE_MIGHTY.NAME"
msgid "Activate Mighty"
msgstr "激活强壮"

#. STRINGS.REFORGED.BUFFS.ACTIVATE_MIGHTY.DESC
msgctxt "STRINGS.REFORGED.BUFFS.ACTIVATE_MIGHTY.DESC"
msgid "Tremble before my might!"
msgstr "在我变得强壮之前颤抖吧！"

#. STRINGS.REFORGED.BUFFS.ACTIVATE_SHADOWS.NAME
msgctxt "STRINGS.REFORGED.BUFFS.ACTIVATE_SHADOWS.NAME"
msgid "Activate Shadows"
msgstr "激活暗影"

#. STRINGS.REFORGED.BUFFS.ACTIVATE_SHADOWS.DESC
msgctxt "STRINGS.REFORGED.BUFFS.ACTIVATE_SHADOWS.DESC"
msgid "Shadows will aid your next attack."
msgstr "暗影将帮助你的下一次攻击。"

#. STRINGS.REFORGED.BUFFS.ACTIVATE_SHOCK.NAME
msgctxt "STRINGS.REFORGED.BUFFS.ACTIVATE_SHOCK.NAME"
msgid "Activate Shock"
msgstr "激活电击"

#. STRINGS.REFORGED.BUFFS.ACTIVATE_SHOCK.DESC
msgctxt "STRINGS.REFORGED.BUFFS.ACTIVATE_SHOCK.DESC"
msgid "Fully charged and ready to shock the next attacker."
