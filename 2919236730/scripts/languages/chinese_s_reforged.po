#. STRINGS.REFORGED.CHARACTER.COOKING.WARLY
msgctxt "STRINGS.REFORGED.CHARACTER.COOKING.WARLY"
msgid "Order up!"
msgstr "上菜啦！"

#. STRINGS.REFORGED.CHARACTER.COOKING.OTHER
msgctxt "STRINGS.REFORGED.CHARACTER.COOKING.OTHER"
msgid "Food is Ready!"
msgstr "饭做好了！"

