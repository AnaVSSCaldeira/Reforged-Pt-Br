msgid "Fire Blast"
msgstr "爆破"

#. STRINGS.REFORGED.WEAPONS.MOLTENDARTS.ABILITIES.FIRE_BLAST.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.MOLTENDARTS.ABILITIES.FIRE_BLAST.DESC"
msgid "Shoot a single fiery blast of magma at your foes!"
msgstr "向敵人射擊一股火熱的岩漿！"

#. STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.NAME"
