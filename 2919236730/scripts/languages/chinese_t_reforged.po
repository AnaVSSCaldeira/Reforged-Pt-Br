msgid ""
msgstr ""
"Application: Dont' Starve\n"
"POT Version: 2.0\n"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.winona
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.winona"
msgid "*All ability cooldowns are 10% faster.\n\n\n\nExpertise:\nMelee, Darts, Staves"
msgstr "*所有技能冷卻時間提高10%。\n\n\n\n擅長:\n近戰, 吹箭, 魔杖"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.warly
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.warly"
msgid "*Brings a spatula to cook boosting food for his allies!\n*Master Chef.\n*Deals 10% more healing.\nExpertise:\nMelee, Staves"
msgstr "*携帶一把鍋鏟來爲他的盟友做飯！\n*大厨。\n*治療效果提高10%。\n擅長:\n近戰, 魔杖"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wortox
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wortox"
msgid "*Spawns with a soul hopping Soul Scepter.\n*Passively sucks the souls of his foes.\n\nExpertise:\nMelee"
msgstr "*生成帶有靈魂跳躍的靈魂權杖。\n*被動地吮吸敵人的靈魂。\n\n擅長:\n近戰"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wormwood
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wormwood"
msgid "*Spawns with a plant-based blowdart.\n*Blossoms over time as long as he avoids damage.\n\nExpertise:\nDarts, Staves"
msgstr "*生成一個植物吹箭。\n*避免受到傷害會隨著時間的流逝而開花。\n\n擅長:\n吹箭, 魔杖"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wurt
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wurt"
msgid "*Can use every weapon available.\n*Melee attacks makes foes wet, making them slow and vulnerable to electric damage.\nExpertise:\nMelee, Darts, Staves, Books"
msgstr "*可以使用所有的武器。\n*受到敵人的近戰攻擊使他們濕透, 變慢, 且對電擊更脆弱。\n擅長:\n近战, 吹箭, 魔杖, 書本"

# -------------------------
# -- LAVAARENA_SEEDDARTS --
# -------------------------

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "It fires seeds and grows sentient plants."
msgstr "它能發射種子並生長有情感的植物。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "I'm not putting my mouth to that!"
msgstr "我不會把嘴放到那上面！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "It breaks in Wolfgang's mighty grip."
msgstr "它打破了沃爾夫岡强壯的握力。"

#. STRINGS.CHARACTERS.WX78.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WX78.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "USELESS ORGANIC DART"
msgstr "沒用的有機吹箭"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "Hey, that's not fire!"
msgstr "嘿, 那不是火！"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "An instrument of life and death."
msgstr "掌握生死的工具。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "I'm not too big on plants, eh?"
msgstr "我不太喜歡植物, 嗯？"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "It's not for me, I'm afraid."
msgstr "這恐怕不是給我的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "A weapon blessed by Idunn!"
msgstr "伊登恩賜的武器！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "We like this one, it makes a friend!"
msgstr "我們喜歡這個, 它能交個朋友！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "That gets the job done!"
msgstr "那個可以完成任務！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "A gnarled weed to shoot some seeds!"
msgstr "一棵粗糙的雜草能射出一些種子！"

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "Ptoo ptoo ptoo!"
msgstr "噗突 噗突 噗突！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "Weaponized seeds?"
msgstr "武器化的種子？"

#. STRINGS.CHARACTERS.WURT.DESCRIBE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.CHARACTERS.WURT.DESCRIBE.LAVAARENA_SEEDDARTS"
msgid "Not a vegetable...?"
msgstr "不是蔬菜...？"

#. STRINGS.NAMES.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.NAMES.LAVAARENA_SEEDDARTS"
msgid "Seedling Darts"
msgstr "幼苗吹箭"

#. STRINGS.ACTIONS.CASTAOE.LAVAARENA_SEEDDARTS
msgctxt "STRINGS.ACTIONS.CASTAOE.LAVAARENA_SEEDDARTS"
msgid "Plant Seedling"
msgstr "植物幼苗"

# ------------------
# -- MEAN_FLYTRAP --
# ------------------

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEAN_FLYTRAP"
msgid "A plant! The boar's natural predator."
msgstr "植物！野豬的天敵。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAN_FLYTRAP"
msgid "He serves us, for now."
msgstr "他現在爲我們服務。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEAN_FLYTRAP"
msgid "Is plant friend."
msgstr "植物的朋友。"

#. STRINGS.CHARACTERS.WX78.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WX78.DESCRIBE.MEAN_FLYTRAP"
msgid "A PLANT MINION FROM THE PLANT MINION"
msgstr "植物隨從的植物隨從"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEAN_FLYTRAP"
msgid "How does a dumb plant grow here?"
msgstr "這株笨植物是如何長在這的？"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEAN_FLYTRAP"
msgid "You too shall perish soon."
msgstr "你也很快將會滅亡。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEAN_FLYTRAP"
msgid "'Ey, he's on our side!"
msgstr "'嘿, 他站在我們這邊！"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEAN_FLYTRAP"
msgid "Flora of this structure can't last long here, sadly."
msgstr "可悲的是, 這種結構的植物無法在這裏持續很長時間。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAN_FLYTRAP"
msgid "Will you fight alongside me, plant?"
msgstr "你能和我一起戰鬥嗎, 植物？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEAN_FLYTRAP"
msgid "Hello! What's your name?"
msgstr "你好！你叫什麽名字？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MEAN_FLYTRAP"
msgid "Look at the set of chompers on him!"
msgstr "看看他身上的排骨！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEAN_FLYTRAP"
msgid "Grown from seeds to do our deeds!"
msgstr "從種子裏長出來去做我們的事！"

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.MEAN_FLYTRAP"
msgid "Brought friend along"
msgstr "帶了朋友過來"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.MEAN_FLYTRAP"
msgid "The produce bites back!"
msgstr "農產品咬回來了！"

#. STRINGS.CHARACTERS.WURT.DESCRIBE.MEAN_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WURT.DESCRIBE.MEAN_FLYTRAP"
msgid "It's a leaf friend! Glort!"
msgstr "是個葉子朋友！太棒了！"

#. STRINGS.NAMES.MEAN_FLYTRAP
msgctxt "STRINGS.NAMES.MEAN_FLYTRAP"
msgid "Seedling"
msgstr "幼苗"

# -------------------------
# -- LAVAARENA_SEEDDART2 --
# -------------------------

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "It fires a triple volley of seeds."
msgstr "它能射出三連發的種子。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "You have to be kidding me."
msgstr "你一定是在逗我。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "Wolfgang's punches mightier than little twig!"
msgstr "沃爾夫岡的拳頭比小薇格弗德更强！"

#. STRINGS.CHARACTERS.WX78.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WX78.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "THIS IS OF NO USE TO ME"
msgstr "這對我沒有用"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "Three shots at once? I'll take that!"
msgstr "一次三發？我接受它！"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "Death in seed form."
msgstr "以種子的形式死亡。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "My plant buddy is afraid to let me have it."
msgstr "我的植物夥伴不敢讓我擁有它。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "Wormwood has an interesting taste in weaponry."
msgstr "沃姆伍德在武器上的品味很有意思。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "I will fight many enemies with this!"
msgstr "我會用它與許多敵人戰鬥！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "It can hit a lot of things at once, just like us!"
msgstr "就像我們一樣, 它能一次擊中很多東西！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "I'll give it a shot. Ha!"
msgstr "我要試一試。哈！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "Seeds that bloom shall spell your doom!"
msgstr "綻放的種子會毀滅你！"

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "Dart shaped like friend!"
msgstr "吹箭的形狀像朋友！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "I must blow thrice as hard for this one."
msgstr "我必須爲此付出三倍的努力。"

#. STRINGS.CHARACTERS.WURT.DESCRIBE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.CHARACTERS.WURT.DESCRIBE.LAVAARENA_SEEDDART2"
msgid "Should be careful with this. Not gonna."
msgstr "應該對它小心一點。不會的。"

#. STRINGS.NAMES.LAVAARENA_SEEDDART2
msgctxt "STRINGS.NAMES.LAVAARENA_SEEDDART2"
msgid "Scattertooth"
msgstr "散射之齒"

#. STRINGS.ACTIONS.CASTAOE.LAVAARENA_SEEDDART2
msgctxt "STRINGS.ACTIONS.CASTAOE.LAVAARENA_SEEDDART2"
msgid "Plant Snaptooth"
msgstr "植物咬牙"

# -------------------
# -- ADULT_FLYTRAP --
# -------------------

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ADULT_FLYTRAP"
msgid "His bark is just as bad as his bite!"
msgstr "他的叫聲和他咬的一樣坏！"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ADULT_FLYTRAP"
msgid "I'm smarter than to move near that thing."
msgstr "我比靠近那東西要聰明。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ADULT_FLYTRAP"
msgid "Scary plant friend."
msgstr "可怕的植物朋友。"

#. STRINGS.CHARACTERS.WX78.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WX78.DESCRIBE.ADULT_FLYTRAP"
msgid "EAT MY ENEMIES, MINION"
msgstr "吃掉我的敵人, 隨從"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ADULT_FLYTRAP"
msgid "Stay back, Bernie. He looks vicious!"
msgstr "呆在後面, 伯尼。他看起來很惡毒！"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ADULT_FLYTRAP"
msgid "Grown to life to reap death..."
msgstr "成長為生命以收穫死亡..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ADULT_FLYTRAP"
msgid "I know better than to chop him, eh?"
msgstr "我知道有比砍他更好的事, 對嗎？"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ADULT_FLYTRAP"
msgid "It recognizes us as allies, thankfully."
msgstr "幸運的是, 它認爲我們是盟友。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ADULT_FLYTRAP"
msgid "Feast like a true warrior, plant!"
msgstr "像真正的戰士一樣盛宴, 植物！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ADULT_FLYTRAP"
msgid "We're afraid he'll eat my friends."
msgstr "我們怕他會吃掉我的朋友們。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ADULT_FLYTRAP"
msgid "He's definitely no flytrap I've ever seen."
msgstr "他絕對不是我見過的捕蠅草。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ADULT_FLYTRAP"
msgid "F-fear me! I'm a scary imp!"
msgstr "怕-怕我！我是個可怕的惡魔！"

#. STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WORMWOOD.DESCRIBE.ADULT_FLYTRAP"
msgid "Help, friend!"
msgstr "幫我, 朋友！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ADULT_FLYTRAP"
msgid "He appears to have a very carnivorous diet."
msgstr "他似乎經常吃肉食。"

#. STRINGS.CHARACTERS.WURT.DESCRIBE.ADULT_FLYTRAP
msgctxt "STRINGS.CHARACTERS.WURT.DESCRIBE.ADULT_FLYTRAP"
msgid "No bite me!"
msgstr "不要咬我！"

#. STRINGS.NAMES.ADULT_FLYTRAP
msgctxt "STRINGS.NAMES.ADULT_FLYTRAP"
msgid "Snaptooth"
msgstr "咬牙"

# -----------------------
# -- LAVAARENA_SPATULA --
# -----------------------

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_SPATULA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_SPATULA"
msgid "I can cook up a hearty meal for everyone with this!"
msgstr "我可以用這個為每個人做豐盛的一餐！"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_SPATULA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_SPATULA"
msgid "There's a time and place for cooking, and this is not it."
msgstr "這裏有做飯的時間和地點, 不是嗎。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.LAVAARENA_SPATULA
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.LAVAARENA_SPATULA"
msgid "Wolfgang cook mighty meal for his friends!"
msgstr "沃爾夫岡為他的朋友們做一頓大餐！"

#. STRINGS.CHARACTERS.WX78.DESCRIBE.LAVAARENA_SPATULA
msgctxt "STRINGS.CHARACTERS.WX78.DESCRIBE.LAVAARENA_SPATULA"
msgid "I WILL DEAL HIGH DEGREES OF PAIN WITH THIS"
msgstr "我將會爲此付出高度的痛苦"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_SPATULA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_SPATULA"
msgid "I'm not using a dumb spatula!"
msgstr "我不會用一個笨炒菜鏟！"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_SPATULA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LAVAARENA_SPATULA"
msgid "A tool unfit for combat."
msgstr "不適合戰鬥的工具。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_SPATULA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_SPATULA"
msgid "I can whip up some mean poutine in a pinch."
msgstr "我可以在緊急情況下攪拌一些普通的肉汁奶酪薯條。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_SPATULA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_SPATULA"
msgid "I am a tad starved, but I cannot prepare a meal right now."
msgstr "我有點餓, 但是現在不能準備飯菜。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_SPATULA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_SPATULA"
msgid "To fight and to feast!"
msgstr "戰鬥和盛宴！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LAVAARENA_SPATULA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LAVAARENA_SPATULA"
msgid "Oh! Are we gonna have a barbeque?"
msgstr "奧！我們要做燒烤嗎？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_SPATULA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_SPATULA"
msgid "Stay back! I'll cook you into a nice boar burger!"
msgstr "呆在後面！我會把你煮成一個很棒的豬肉漢堡！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_SPATULA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_SPATULA"
msgid "These mortals can never stop eating."
msgstr "這些凡人永遠不停地吃。"

