msgstr "增加所有怪物x%的傷害。"

#. STRINGS.REFORGED.BUFFS.BATTLESTANDARD_SHIELD.NAME
msgctxt "STRINGS.REFORGED.BUFFS.BATTLESTANDARD_SHIELD.NAME"
msgid "Shield Banner"
msgstr "掩護旗幟"

