msgctxt "STRINGS.REFORGED.ENEMIES.BOARRIOR.ABILITIES.REINFORCEMENTS.DESC"
msgid "Claps his weapons together summoning pitpig reinforcements with banners."
msgstr "拍打他的武器並召喚帶旗幟的小豬。"

#. STRINGS.REFORGED.ENEMIES.BOARRIOR.ABILITIES.DASH.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.BOARRIOR.ABILITIES.DASH.NAME"
msgid "Dash"
msgstr "衝撞"

#. STRINGS.REFORGED.ENEMIES.BOARRIOR.ABILITIES.DASH.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.BOARRIOR.ABILITIES.DASH.DESC"
msgid "If target is too far away then Boarrior dashes towards them."
msgstr "如果目標距離太遠, 豬戰士就會向他們衝撞。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO.NAME"
msgid "Rhinocebro Snapback"
msgstr "後扣帽犀牛兄弟"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO.DESC"
msgid "Would probably steal your lunch money."
msgstr "可能會偷走你的午飯錢。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.CHEER.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.CHEER.NAME"
msgid "Bro Cheer"
msgstr "兄弟歡呼"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.CHEER.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.CHEER.DESC"
msgid "Cheers his bro, Flatbrim, to gain a permanent +25 damage boost."
msgstr "為他的平簷帽兄弟歡呼, 獲得永久的+25傷害加成。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.RAM.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.RAM.NAME"
msgid "Ram"
msgstr "撞擊"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.RAM.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO.ABILITIES.RAM.DESC"
msgid "Charges forward with his horn doing damage in a large radius."
msgstr "用他的角向前衝鋒, 造成大範圍的傷害。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.NAME"
msgid "Rhinocebro Flatbrim"
msgstr "平簷帽犀牛兄弟"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.DESC"
msgid "Would probably stuff you in a locker."
msgstr "可能會將你塞進儲物櫃。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.CHEER.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.CHEER.NAME"
msgid "Bro Cheer"
msgstr "兄弟歡呼"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.CHEER.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.CHEER.DESC"
msgid "Cheers his bro, Snapback, to gain a permanent +25 damage boost."
msgstr "為他的後扣帽兄弟歡呼, 獲得永久的+25傷害加成。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.RAM.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.RAM.NAME"
msgid "Ram"
msgstr "撞擊"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.RAM.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBRO2.ABILITIES.RAM.DESC"
msgid "Charges forward with his horn doing damage in a large radius."
msgstr "用他的角向前衝鋒, 造成大範圍的傷害。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBROS.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBROS.NAME"
msgid "Rhinocebros"
msgstr "犀牛兄弟"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBROS.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBROS.DESC"
msgid "Spawn the two as a pair, linked and everything."
msgstr "生成兩個成對, 聯結在一起和所有一切。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.CHEER.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.CHEER.NAME"
msgid "Bro Cheer"
msgstr "兄弟歡呼"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.CHEER.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.CHEER.DESC"
msgid "Cheer each other to gain a permanent +25 damage boost."
msgstr "互相歡呼, 獲得永久的+25傷害加成。"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.RAM.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.RAM.NAME"
msgid "Ram"
msgstr "撞擊"

#. STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.RAM.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.RHINOCEBROS.ABILITIES.RAM.DESC"
msgid "Charges forward with his horn doing damage in a large radius."
msgstr "用他的角向前衝鋒, 造成大範圍的傷害。"

#. STRINGS.REFORGED.ENEMIES.SWINECLOPS.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.SWINECLOPS.NAME"
msgid "Infernal Swineclops"
msgstr "地獄獨眼巨豬"

#. STRINGS.REFORGED.ENEMIES.SWINECLOPS.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.SWINECLOPS.DESC"
msgid "Pugna's last resort, a ferocious beast imprisoned for how deadly he is."
msgstr "普格納的最後一招是一隻凶猛的野獸, 因他的致命性而入獄。"

#. STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.DEFENSIVE_STANCE.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.DEFENSIVE_STANCE.NAME"
msgid "Defensive Stance"
msgstr "防守姿態"

#. STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.DEFENSIVE_STANCE.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.DEFENSIVE_STANCE.DESC"
msgid "Moves faster, takes 50% less damage, but can only do one attack."
msgstr "移速更快, 受到的傷害降低50%, 但只能進行一次攻擊。"

#. STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.OFFENSIVE_STANCE.NAME
msgctxt "STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.OFFENSIVE_STANCE.NAME"
msgid "Offensive Stance"
msgstr "進攻姿態"

#. STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.OFFENSIVE_STANCE.DESC
msgctxt "STRINGS.REFORGED.ENEMIES.SWINECLOPS.ABILITIES.OFFENSIVE_STANCE.DESC"
msgid "Can combo punches, can buff itself, can use bellyflop, but moves slower."
msgstr "可以連擊, 可以增幅自己, 可以用肚皮攻擊, 但移速較慢。"

# ---------
# -- PET --
# ---------

#. STRINGS.REFORGED.PETS.GOLEM.NAME
msgctxt "STRINGS.REFORGED.PETS.GOLEM.NAME"
msgid "Golem"
msgstr "傀儡"

#. STRINGS.REFORGED.PETS.GOLEM.DESC
msgctxt "STRINGS.REFORGED.PETS.GOLEM.DESC"
msgid "Continously throws fireballs at nearby mobs. Can't move though."
msgstr "不斷向附近的怪物扔火球, 雖然它不能移動。"

#. STRINGS.REFORGED.PETS.BABYSPIDER.NAME
msgctxt "STRINGS.REFORGED.PETS.BABYSPIDER.NAME"
msgid "Baby Spiders"
msgstr "蜘蛛寶寶"

#. STRINGS.REFORGED.PETS.BABYSPIDER.DESC
msgctxt "STRINGS.REFORGED.PETS.BABYSPIDER.DESC"
msgid "These cute lil fellas will help you take down foes. They can't be targeted or killed."
msgstr "這些可愛的小家夥們會幫你擊倒敵人。他們無法成爲目標或被殺死。"

#. STRINGS.REFORGED.PETS.MERM_GUARD.NAME
msgctxt "STRINGS.REFORGED.PETS.MERM_GUARD.NAME"
msgid "Merm Guard"
msgstr "魚人守衛"

#. STRINGS.REFORGED.PETS.MERM_GUARD.DESC
msgctxt "STRINGS.REFORGED.PETS.MERM_GUARD.DESC"
msgid "From the swamp comes the menacing merm guards. They will die from overheating after awhile."
msgstr "險惡的魚人守衛從沼澤中來。他們過一會就會因過熱而死。"

#. STRINGS.REFORGED.PETS.MEAN_FLYTRAP.NAME
msgctxt "STRINGS.REFORGED.PETS.MEAN_FLYTRAP.NAME"
msgid "Seedling"
msgstr "幼苗"

#. STRINGS.REFORGED.PETS.MEAN_FLYTRAP.DESC
msgctxt "STRINGS.REFORGED.PETS.MEAN_FLYTRAP.DESC"
msgid "Wormwood's friends have come to lend a tooth or two. They will die from the heat after awhile."
msgstr "沃姆伍德的朋友過來借一兩顆牙。他們過一會就會因過熱而死。"

#. STRINGS.REFORGED.PETS.ADULT_FLYTRAP.NAME
msgctxt "STRINGS.REFORGED.PETS.ADULT_FLYTRAP.NAME"
msgid "Snaptooth"
msgstr "咬牙"

#. STRINGS.REFORGED.PETS.ADULT_FLYTRAP.DESC
msgctxt "STRINGS.REFORGED.PETS.ADULT_FLYTRAP.DESC"
msgid "This fiend will take large bites out of the competition. They will die from the heat after awhile."
msgstr "這個惡魔會在競爭中占上風。他們過一會就會因過熱而死。"

#. STRINGS.REFORGED.PETS.FORGE_ABIGAIL.NAME
msgctxt "STRINGS.REFORGED.PETS.FORGE_ABIGAIL.NAME"
msgid "Abigail"
msgstr "阿比蓋爾"

#. STRINGS.REFORGED.PETS.FORGE_ABIGAIL.DESC
msgctxt "STRINGS.REFORGED.PETS.FORGE_ABIGAIL.DESC"
msgid "Wendy's sister has come to throw the game. Respawns quite awhile after death."
msgstr "溫蒂的姐姐過來故意輸掉比賽。死亡後用相當長的時間重生。"

#. STRINGS.REFORGED.PETS.FORGE_BERNIE.NAME
msgctxt "STRINGS.REFORGED.PETS.FORGE_BERNIE.NAME"
msgid "Bernie"
msgstr "伯尼"

#. STRINGS.REFORGED.PETS.FORGE_BERNIE.DESC
msgctxt "STRINGS.REFORGED.PETS.FORGE_BERNIE.DESC"
msgid "He will draw aggro away from you when you're in danger. Can be revived when fallen."
msgstr "在你處於危險之中時, 他會從你身邊吸引仇恨。跌倒時可以復活。"

# -----------
# -- HELMS --
# -----------

#. STRINGS.REFORGED.HELMS.FEATHEREDWREATH.NAME
msgctxt "STRINGS.REFORGED.HELMS.FEATHEREDWREATH.NAME"
msgid "Feathered Wreath"
msgstr "羽毛頭環"

#. STRINGS.REFORGED.HELMS.FEATHEREDWREATH.DESC
msgctxt "STRINGS.REFORGED.HELMS.FEATHEREDWREATH.DESC"
msgid "Have feet as light as a feather and have the hat to match!"
msgstr "脚像羽毛一樣輕, 并且有匹配的帽子！"

#. STRINGS.REFORGED.HELMS.FLOWERHEADBAND.NAME
msgctxt "STRINGS.REFORGED.HELMS.FLOWERHEADBAND.NAME"
msgid "Flower Headband"
msgstr "花飾頭帶"

#. STRINGS.REFORGED.HELMS.FLOWERHEADBAND.DESC
msgctxt "STRINGS.REFORGED.HELMS.FLOWERHEADBAND.DESC"
msgid "Wear a healing flower on your head! When healed, gain 25% more health."
msgstr "戴在頭上的愈合花！被治愈時, 獲得額外25%的生命值。"

#. STRINGS.REFORGED.HELMS.BARBEDHELM.NAME
msgctxt "STRINGS.REFORGED.HELMS.BARBEDHELM.NAME"
msgid "Barbed Helm"
msgstr "帶刺頭盔"

#. STRINGS.REFORGED.HELMS.BARBEDHELM.DESC
msgctxt "STRINGS.REFORGED.HELMS.BARBEDHELM.DESC"
msgid "Feel the wrath of Barb! Physical attacks deal 10% more damage."
msgstr "感受帶刺的憤怒！物理攻擊額外提高10%。"

#. STRINGS.REFORGED.HELMS.NOXHELM.NAME
msgctxt "STRINGS.REFORGED.HELMS.NOXHELM.NAME"
msgid "Nox Helm"
msgstr "諾克斯牛頭盔"

#. STRINGS.REFORGED.HELMS.NOXHELM.DESC
msgctxt "STRINGS.REFORGED.HELMS.NOXHELM.DESC"
msgid "More horns always means more damage. Specifically, 15% damage."
msgstr "更多的角總是意味著更多的傷害。具體來説, 15%傷害。"

#. STRINGS.REFORGED.HELMS.WOVENGARLAND.NAME
msgctxt "STRINGS.REFORGED.HELMS.WOVENGARLAND.NAME"
msgid "Woven Garland"
msgstr "編織花環"

#. STRINGS.REFORGED.HELMS.WOVENGARLAND.DESC
msgctxt "STRINGS.REFORGED.HELMS.WOVENGARLAND.DESC"
msgid "Imbued with the power of a mythical dryad, this increases healing dealt by 20%."
msgstr "充滿神話般樹妖的力量, 可以使治療量提高20%。"

#. STRINGS.REFORGED.HELMS.CLAIRVOYANTCROWN.NAME
msgctxt "STRINGS.REFORGED.HELMS.CLAIRVOYANTCROWN.NAME"
msgid "Clairvoyant Crown"
msgstr "洞察皇冠"

#. STRINGS.REFORGED.HELMS.CLAIRVOYANTCROWN.DESC
msgctxt "STRINGS.REFORGED.HELMS.CLAIRVOYANTCROWN.DESC"
msgid "Become a minister of magic! Deal more magic damage, have faster cooldowns and movement speed."
msgstr "成爲魔法部長！造成更多魔法傷害, 並具有更快的冷卻時間和移速。"

#. STRINGS.REFORGED.HELMS.CRYSTALTIARA.NAME
msgctxt "STRINGS.REFORGED.HELMS.CRYSTALTIARA.NAME"
msgid "Crystal Tiara"
msgstr "水晶頭飾"

#. STRINGS.REFORGED.HELMS.CRYSTALTIARA.DESC
msgctxt "STRINGS.REFORGED.HELMS.CRYSTALTIARA.DESC"
msgid "Apparently healing crystals aren't a sham! Gain 10% faster cooldowns."
msgstr "顯然治愈水晶不是假的！冷卻時間提高10%。"

#. STRINGS.REFORGED.HELMS.BLOSSOMEDWREATH.NAME
msgctxt "STRINGS.REFORGED.HELMS.BLOSSOMEDWREATH.NAME"
msgid "Blossomed Wreath"
msgstr "綻放花環"

#. STRINGS.REFORGED.HELMS.BLOSSOMEDWREATH.DESC
msgctxt "STRINGS.REFORGED.HELMS.BLOSSOMEDWREATH.DESC"
msgid "Put a miniature healing circle right on your head! Heals 2 HP/sec."
msgstr "在你的頭上放一個微型治愈圈！每秒恢復2生命值。"

#. STRINGS.REFORGED.HELMS.RESPLENDENTNOXHELM.NAME
msgctxt "STRINGS.REFORGED.HELMS.RESPLENDENTNOXHELM.NAME"
msgid "Resplendent Nox Helm"
msgstr "華麗的諾克斯牛頭盔"

#. STRINGS.REFORGED.HELMS.RESPLENDENTNOXHELM.DESC
msgctxt "STRINGS.REFORGED.HELMS.RESPLENDENTNOXHELM.DESC"
msgid "This excessive amount of horns grants high physical damage, faster cooldowns and movement speed."
msgstr "過多的角造成很高的物理傷害, 且具有更快的冷卻時間和移速。"

#. STRINGS.REFORGED.HELMS.LAVAARENA_CHEFHAT.NAME
msgctxt "STRINGS.REFORGED.HELMS.LAVAARENA_CHEFHAT.NAME"
msgid "Chef Hat"
msgstr "厨師帽"

#. STRINGS.REFORGED.HELMS.LAVAARENA_CHEFHAT.DESC
msgctxt "STRINGS.REFORGED.HELMS.LAVAARENA_CHEFHAT.DESC"
msgid "Wearing this, everyone will believe that you're a master chef, so you no longer need to watch your own food cook."
msgstr "戴上它后所有人都會相信你是大厨, 因此你不再需要看鍋。"

# ----------
# -- BODY --
# ----------

#. STRINGS.REFORGED.ARMOR.REEDTUNIC.NAME
msgctxt "STRINGS.REFORGED.ARMOR.REEDTUNIC.NAME"
msgid "Reed Tunic"
msgstr "蘆葦束腰外衣"

#. STRINGS.REFORGED.ARMOR.REEDTUNIC.DESC
msgctxt "STRINGS.REFORGED.ARMOR.REEDTUNIC.DESC"
msgid "Reeds aren't the best form of defense."
msgstr "蘆葦不是最好的防禦方式。"

#. STRINGS.REFORGED.ARMOR.FEATHEREDTUNIC.NAME
msgctxt "STRINGS.REFORGED.ARMOR.FEATHEREDTUNIC.NAME"
msgid "Feathered Reed Tunic"
msgstr "帶羽毛的蘆葦外衣"

#. STRINGS.REFORGED.ARMOR.FEATHEREDTUNIC.DESC
msgctxt "STRINGS.REFORGED.ARMOR.FEATHEREDTUNIC.DESC"
msgid "A feather got stuck in your tunic. It makes you run slightly faster."
msgstr "在你的外衣上卡著一根羽毛。它使你跑得稍快一點。"

#. STRINGS.REFORGED.ARMOR.FORGE_WOODARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.FORGE_WOODARMOR.NAME"
msgid "Wood Armor"
msgstr "木製護甲"

#. STRINGS.REFORGED.ARMOR.FORGE_WOODARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.FORGE_WOODARMOR.DESC"
msgid "Simple yet effective defense."
msgstr "簡單而有效的防禦。"

#. STRINGS.REFORGED.ARMOR.JAGGEDARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.JAGGEDARMOR.NAME"
msgid "Jagged Wood Armor"
msgstr "鋸齒木架"

#. STRINGS.REFORGED.ARMOR.JAGGEDARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.JAGGEDARMOR.DESC"
msgid "Decked out in monster teeth, this armor protects AND attacks."
msgstr "鑲有怪獸牙齒的裝飾, 這個護甲可以保護和攻擊。"

#. STRINGS.REFORGED.ARMOR.SILKENARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.SILKENARMOR.NAME"
msgid "Silken Wood Armor"
msgstr "軟木護甲"

#. STRINGS.REFORGED.ARMOR.SILKENARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.SILKENARMOR.DESC"
msgid "This very simple sash wrapped around wood grants faster cooldowns."
msgstr "這個很簡單地包裹在木頭上的飾帶可以加快冷卻時間。"

#. STRINGS.REFORGED.ARMOR.SPLINTMAIL.NAME
msgctxt "STRINGS.REFORGED.ARMOR.SPLINTMAIL.NAME"
msgid "Stone Splint Mail"
msgstr "石頭板甲"

#. STRINGS.REFORGED.ARMOR.SPLINTMAIL.DESC
msgctxt "STRINGS.REFORGED.ARMOR.SPLINTMAIL.DESC"
msgid "Light stone armor that grants higher defense than wood."
msgstr "輕製石盔甲的防禦力高於木製。"

#. STRINGS.REFORGED.ARMOR.STEADFASTARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.STEADFASTARMOR.NAME"
msgid "Steadfast Stone Armor"
msgstr "堅固的石製護甲"

#. STRINGS.REFORGED.ARMOR.STEADFASTARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.STEADFASTARMOR.DESC"
msgid "Too many rocks! This heavy armor slows you down, but makes you harder to push around."
msgstr "石頭太多了！這種沉重的盔甲會使你減速, 但會使你更難被推開。"

#. STRINGS.REFORGED.ARMOR.STEADFASTGRANDARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.STEADFASTGRANDARMOR.NAME"
msgid "Steadfast Grand Armor"
msgstr "華麗的穩固盔甲"

#. STRINGS.REFORGED.ARMOR.STEADFASTGRANDARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.STEADFASTGRANDARMOR.DESC"
msgid "Become the ultimate tank!"
msgstr "成爲終極坦克！"

#. STRINGS.REFORGED.ARMOR.WHISPERINGGRANDARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.WHISPERINGGRANDARMOR.NAME"
msgid "Whispering Grand Armor"
msgstr "華麗的低語盔甲"

#. STRINGS.REFORGED.ARMOR.WHISPERINGGRANDARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.WHISPERINGGRANDARMOR.DESC"
msgid "Boost your companions with ancient power!"
msgstr "用古老的力量助你一臂之力！"

#. STRINGS.REFORGED.ARMOR.SILKENGRANDARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.SILKENGRANDARMOR.NAME"
msgid "Silken Grand Armor"
msgstr "華麗的絲滑盔甲"

#. STRINGS.REFORGED.ARMOR.SILKENGRANDARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.SILKENGRANDARMOR.DESC"
msgid "The supreme stamina booster!"
msgstr "優質的耐力助推器！"

#. STRINGS.REFORGED.ARMOR.JAGGEDGRANDARMOR.NAME
msgctxt "STRINGS.REFORGED.ARMOR.JAGGEDGRANDARMOR.NAME"
msgid "Jagged Grand Armor"
msgstr "華麗的尖突盔甲"

#. STRINGS.REFORGED.ARMOR.JAGGEDGRANDARMOR.DESC
msgctxt "STRINGS.REFORGED.ARMOR.JAGGEDGRANDARMOR.DESC"
msgid "Rip and tear through your foes with this armor!"
msgstr "用這個盔甲撕裂敵人！"

# -------------
# -- WEAPONS --
# -------------

#. STRINGS.REFORGED.WEAPONS.FORGEDARTS.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FORGEDARTS.NAME"
msgid "Darts"
msgstr "吹箭"

#. STRINGS.REFORGED.WEAPONS.FORGEDARTS.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FORGEDARTS.DESC"
msgid "A simple yet powerful blowdart."
msgstr "一個簡單而强大的吹箭。"

#. STRINGS.REFORGED.WEAPONS.FORGEDARTS.ABILITIES.BARRAGE.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FORGEDARTS.ABILITIES.BARRAGE.NAME"
msgid "Barrage"
msgstr "齊射"

#. STRINGS.REFORGED.WEAPONS.FORGEDARTS.ABILITIES.BARRAGE.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FORGEDARTS.ABILITIES.BARRAGE.DESC"
msgid "Shoot a flurry of darts in one direction."
msgstr "朝一個方向射擊一連串吹箭。"

#. STRINGS.REFORGED.WEAPONS.MOLTENDARTS.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.MOLTENDARTS.NAME"
msgid "Molten Darts"
msgstr "融化吹箭"

#. STRINGS.REFORGED.WEAPONS.MOLTENDARTS.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.MOLTENDARTS.DESC"
msgid "Don't burn your tongue!"
msgstr "不要燒壞你的舌頭！"

#. STRINGS.REFORGED.WEAPONS.MOLTENDARTS.ABILITIES.FIRE_BLAST.NAME
