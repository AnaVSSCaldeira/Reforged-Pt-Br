msgctxt "STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.DESC"
msgid "Harness the power of fire!"
msgstr "利用火的力量！"

#. STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.ABILITIES.METEOR.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.ABILITIES.METEOR.NAME"
msgid "Meteor"
msgstr "流星"

#. STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.ABILITIES.METEOR.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.INFERNALSTAFF.ABILITIES.METEOR.DESC"
msgid "Call down a giant meteor from the heavens!"
msgstr "從天堂裏召喚一顆巨大的流星！"

#. STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.NAME"
msgid "Forge Hammer"
msgstr "熔爐錘"

#. STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.DESC"
msgid "Bash some skulls in with this heavy hammer."
msgstr "用沉重的錘子雜碎一些頭骨。"

#. STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.ABILITIES.SLAM.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.ABILITIES.SLAM.NAME"
msgid "Slam"
msgstr "撞擊"

#. STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.ABILITIES.SLAM.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FORGINGHAMMER.ABILITIES.SLAM.DESC"
msgid "Shake the ground at your feet, hitting everything at once."
msgstr "在你的脚下搖動地面, 一次擊中一切。"

#. STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.NAME"
msgid "Living Staff"
msgstr "生存魔杖"

#. STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.DESC"
msgid "A very useful tool to keep you and your allies alive."
msgstr "一個非常有用的工具, 可以使你和你的盟友存活。"

#. STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.ABILITIES.HEALING_CIRCLE.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.ABILITIES.HEALING_CIRCLE.NAME"
msgid "Healing Circle"
msgstr "治療圈"

#. STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.ABILITIES.HEALING_CIRCLE.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.LIVINGSTAFF.ABILITIES.HEALING_CIRCLE.DESC"
msgid "Spawn a magical circle of blossoming healing flowers."
msgstr "生成一個神奇的治愈花圈。"

#. STRINGS.REFORGED.WEAPONS.PITHPIKE.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.PITHPIKE.NAME"
msgid "Spear"
msgstr "長矛"

#. STRINGS.REFORGED.WEAPONS.PITHPIKE.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.PITHPIKE.DESC"
msgid "Wigfrid's go-to weapon for battle."
msgstr "薇格弗德的戰鬥必備武器。"

#. STRINGS.REFORGED.WEAPONS.PITHPIKE.ABILITIES.CHARGE.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.PITHPIKE.ABILITIES.CHARGE.NAME"
msgid "Charge"
msgstr "衝撞"

#. STRINGS.REFORGED.WEAPONS.PITHPIKE.ABILITIES.CHARGE.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.PITHPIKE.ABILITIES.CHARGE.DESC"
msgid "Dash through your foes, and flip some Snortoises while you're at it."
msgstr "衝刺穿過敵人, 並在衝刺時翻轉一些坦克龜。"

#. STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.NAME"
msgid "Spiral Spear"
msgstr "螺旋矛"

#. STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.DESC"
msgid "Keep the pointy end away from you!"
msgstr "保持遠離尖銳末端！"

#. STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.ABILITIES.SLAM.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.ABILITIES.SLAM.NAME"
msgid "Slam"
msgstr "猛擊"

#. STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.ABILITIES.SLAM.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.SPIRALSPEAR.ABILITIES.SLAM.DESC"
