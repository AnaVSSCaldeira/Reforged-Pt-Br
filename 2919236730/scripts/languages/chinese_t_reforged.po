#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.NAME"
msgid "Seedling Darts"
msgstr "幼苗吹箭"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.DESC"
msgid "Wormwood put his heart into this. And his other limbs."
msgstr "沃姆伍德對此全心全意。還有他的其它肢體。"

#. STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.ABILITIES.PLANT_SEEDLING.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.LAVAARENA_SEEDDARTS.ABILITIES.PLANT_SEEDLING.NAME"
