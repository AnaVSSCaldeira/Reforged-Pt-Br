msgstr "沒有任何東西可以穿透這把重劍！"

#. STRINGS.REFORGED.WEAPONS.SEEDLINGTOME.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.SEEDLINGTOME.NAME"
msgid "Seedling Tome"
msgstr "幼苗之書"

