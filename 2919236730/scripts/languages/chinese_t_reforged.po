msgctxt "STRINGS.REFORGED.BUFFS.ACTIVATE_AMPLIFY.DESC"
msgid "Make yourself sparkly!"
msgstr "讓你自己更閃耀！"

#. STRINGS.REFORGED.BUFFS.ACTIVATE_MIGHTY.NAME
msgctxt "STRINGS.REFORGED.BUFFS.ACTIVATE_MIGHTY.NAME"
