msgstr "跳入高空, 朝敵人向下猛擊！"

#. STRINGS.REFORGED.WEAPONS.RILEDLUCY.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.RILEDLUCY.NAME"
msgid "Riled Lucy"
msgstr "暴怒的露西"

#. STRINGS.REFORGED.WEAPONS.RILEDLUCY.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.RILEDLUCY.DESC"
msgid "This Lucy is a lot more quiet and ready to fight."
msgstr "這個露西安靜的多, 隨時準備戰鬥。"

#. STRINGS.REFORGED.WEAPONS.RILEDLUCY.ABILITIES.THROW.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.RILEDLUCY.ABILITIES.THROW.NAME"
msgid "Throw"
msgstr "扔"

#. STRINGS.REFORGED.WEAPONS.RILEDLUCY.ABILITIES.THROW.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.RILEDLUCY.ABILITIES.THROW.DESC"
