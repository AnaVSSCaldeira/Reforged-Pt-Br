msgstr "召喚一個遠古朋友。"

#. STRINGS.REFORGED.WEAPONS.BACONTOME.ABILITIES.SUMMON_GOLEM.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.BACONTOME.ABILITIES.SUMMON_GOLEM.NAME"
msgid "Summon Golem"
msgstr "召喚傀儡"

#. STRINGS.REFORGED.WEAPONS.BACONTOME.ABILITIES.SUMMON_GOLEM.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.BACONTOME.ABILITIES.SUMMON_GOLEM.DESC"
msgid "Spawns a rock golem from the depths of the Forge."
msgstr "從熔爐地底深處生成一個石頭傀儡。"

#. STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.NAME"
msgid "Petrifying Tome"
msgstr "石化之書"

#. STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.DESC"
