msgstr "石化"

#. STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.ABILITIES.PETRIFY.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.PETRIFYINGTOME.ABILITIES.PETRIFY.DESC"
msgid "Encase your foes in a tomb of rocks. Not all of them will stay though."
msgstr "將敵人包裹在一塊岩石墓中。儘管並非所有人都會留下來。"

#. STRINGS.REFORGED.WEAPONS.FIREBOMB.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FIREBOMB.NAME"
msgid "Hearthsfire Crystals"
msgstr "爐火晶石"

#. STRINGS.REFORGED.WEAPONS.FIREBOMB.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FIREBOMB.DESC"
msgid "Don't shake it!"
msgstr "不要搖動它！"

#. STRINGS.REFORGED.WEAPONS.FIREBOMB.ABILITIES.THROW.NAME
msgctxt "STRINGS.REFORGED.WEAPONS.FIREBOMB.ABILITIES.THROW.NAME"
msgid "Explosive Throw"
msgstr "爆炸投擲"

#. STRINGS.REFORGED.WEAPONS.FIREBOMB.ABILITIES.THROW.DESC
msgctxt "STRINGS.REFORGED.WEAPONS.FIREBOMB.ABILITIES.THROW.DESC"
